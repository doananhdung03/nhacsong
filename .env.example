# Supabase project URL and publishable (anon) key. Table: supabase/songs.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only YouTube Data API v3 key
YOUTUBE_API_KEY=

# Server-only: database key access and authorized admin email
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=

# Optional canonical public URL; defaults to https://nhacsong.vercel.app
SITE_URL=https://nhacsong.vercel.app
